# Local development defaults. Copy to .env and adjust; nothing here is a secret.

# The development placeholder. Generate a unique value for anything you serve:
# the app refuses to start with this key unless DEBUG is on.
SECRET_KEY=dev-insecure-key-change-me
# Explicitly on for local work. The application default is off, so a deployment
# that forgets this variable does not serve tracebacks.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Left unset, the database is backend/db.sqlite3 wherever you run from. A
# relative sqlite:// URL here would instead put it in the current directory.
# DATABASE_URL=postgres://hcv:hcv@localhost:5432/hcv
REDIS_URL=redis://localhost:6379/0
# Django-Q2 worker processes; each runs one pipeline repetition end to end.
Q_WORKERS=2
# Seconds a worker may spend on one repetition before it is killed as stuck.
Q_TIMEOUT=3600
# Seconds before an unfinished task is re-queued; must exceed Q_TIMEOUT above.
Q_RETRY=4200
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
OPENROUTER_API_KEY=
